;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: an ISCO 2142 Civil Engineers blueprint -- design/analysis is
;; cognitive; physical execution is robotics-gated. The physical work such
;; engineers specify and check: tension-testing reinforcing bar from a
;; delivered batch, and how deep the concrete cover must be for the bar to
;; survive a one-hour fire.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-2142"
 :cases
 [{:id :rebar-batch-tension-test
   :kind :material
   :procedure "test robot pulls a D13 reinforcing bar specimen from a delivered batch to 70 kN and records the yield load"
   :params {:length-m 0.10 :area-m2 1.267e-4 :youngs-modulus-pa 200.0e9
            :hardening-pa 2.0e9 :density-kg-m3 7850.0 :max-force-n 70000.0}
   :sweep {:param :yield-stress-pa :values [300.0e6 330.0e6 345.0e6 390.0e6 440.0e6]}
   :quantity :yield-force-n
   :limit {:min 43712.0 :basis "JIS G 3112 SD345: yield point >= 345 N/mm2, times the D13 nominal cross-section 126.7 mm2"}
   :boundary {:lo 300.0e6 :hi 440.0e6}}
  {:id :cover-fire-exposure
   :kind :thermal
   :procedure "concrete cover over the bar is exposed to a fire for one hour; temperature at the bar depth"
   :params {:conductivity-w-mk 1.6 :density-kg-m3 2300.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 945.0 :h-front-w-m2k 25.0
            :t-back-ambient-c 20.0 :h-back-w-m2k 0.0
            :threshold-c 500.0 :duration-s 3600.0 :nodes 11}
   :sweep {:param :thickness-m :values [0.01 0.02 0.03 0.04 0.06]}
   :quantity :final-back-c
   :limit {:max 500.0 :basis "estimate: ~500 C taken as the critical temperature of reinforcing steel; gas at the ISO 834 60-minute temperature (945 C) held constant, convection only"}
   :boundary {:lo 0.005 :hi 0.08}}]}
